#!/bin/bash
# PostToolUse hook for Claude Code and Codex (matcher Write|Edit, async): hands the new text to Board's AI mode on this Mac.
# Board writes its PID to "listening" only while AI mode is on, so this does nothing unless Board is running with it.
# The text goes into Board's own folder, capped at 4 KB; Board reads and deletes it at once. Nothing is logged or sent.
dir="$HOME/Library/Application Support/Board/AI Queue"
pid="$(head -c 16 "$dir/listening" 2>/dev/null)" || exit 0
case "$pid" in ''|*[!0-9]*) exit 0 ;; esac
comm="$(ps -p "$pid" -o comm= 2>/dev/null)" || exit 0
[ "${comm##*/}" = Board ] || exit 0
# Passed to osascript as an argument, so stay well under macOS's 1 MB argument limit.
input="$(head -c 524288)"
# JavaScript via osascript (part of macOS) reads the JSON; plutil can't, because Codex's input contains nulls.
# Claude Code: Write sends tool_input.content, Edit sends tool_input.new_string.
# Codex: apply_patch sends its patch as tool_input.command; the added lines start with "+".
text="$(osascript -l JavaScript - "$input" 2>/dev/null <<'JS'
function run(argv) {
  let input
  try { input = JSON.parse(argv[0]) } catch (e) { return "" }
  const tool = (input && input.tool_input) || {}
  if (typeof tool.content === "string") return tool.content
  if (typeof tool.new_string === "string") return tool.new_string
  if (typeof tool.command === "string" && tool.command.startsWith("*** Begin Patch"))
    return tool.command.split("\n").filter(line => line.startsWith("+")).map(line => line.slice(1)).join("\n")
  return ""
}
JS
)" || exit 0
[ -n "$text" ] || exit 0
umask 077
tmp="$dir/.$$.tmp"
printf '%s' "$text" | head -c 4096 > "$tmp" && mv -f "$tmp" "$dir/$(date +%s)-$$.txt"
